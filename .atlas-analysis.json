  "keyFeatures": [
    "Full reverse engineering of kbdkni.dll via KbdLayerDescriptor and ToUnicodeEx — 144/144 matches, zero mismatches",
    "Authoritative nida_layout.json spec covering all 49 keys, 4 modifier states, and 5 multi-character ligatures",
    "macOS .keylayout bundles with full ligature support (all five srak/srah sequences)",
    "Linux XKB symbols files with partial ligature support and optional m17n input method for full ligatures",
    "Self-contained shell installers for both platforms — no repository clone required",
    "Reproducible, deterministic build pipeline via verify_all.ps1 with byte-identical output",
    "Comparison with legacy Khmer layout (kbdkhmr.dll) exposing the missing Shift+AltGr symbol block",
    "Unicode Character Database integration for official Khmer character names"
  ],
  "publicApiSurface": [
    "scripts/verify_all.ps1 [-SkipRegenerate]",
    "scripts/dump_kbd_tables.ps1 -Dll <kbdkni.dll|kbdkhmr.dll|kbdus.dll>",
